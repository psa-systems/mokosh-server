{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>psa-systems/common:renovate-default"
  ],
  "gitAuthor": "renovate-bot <renovate-bot@users.noreply.dev.a8n.run>",
  "osvVulnerabilityAlerts": true,
  "enabledManagers": [
    "cargo",
    "docker-compose",
    "dockerfile",
    "github-actions"
  ],
  "packageRules": [
    {
      "description": "Rust toolchain stays on its own: a toolchain bump has to land before any crate update that needs its new MSRV, so it cannot be folded into the general stream.",
      "groupName": "rust toolchain",
      "matchPackageNames": [
        "rust",
        "rustc"
      ]
    }
  ]
}
