# Mokosh Server Environment Configuration
#
# Do NOT copy this file to .env by hand. Run `just dev` (or any recipe that
# depends on `ensure-env`); on first .env creation that recipe generates a
# strong random value for every self-owned secret (DB passwords, JWT_SECRET,
# ENCRYPTION_KEY, the Infisical encryption/auth secrets) so no generic password
# ever lands in .env (PMS-490). The self-owned secret values below are therefore
# left empty on purpose - they are placeholders the generator fills in.
# The SMTP relay settings are the only third-party credentials you fill in by
# hand; `just infisical-bootstrap` writes the Infisical Universal Auth values.

# Application database. Runs as the `postgres` service inside the dev
# compose stack; the host-published port (default 5433) is what sqlx-cli
# and other host-side tools connect to. Container-side connection is
# composed inline in compose.dev.yml from the MOKOSH_PG_* knobs below.
MOKOSH_PG_DB=mokosh
MOKOSH_PG_USER=postgres
MOKOSH_PG_PASSWORD=
MOKOSH_PG_HOST_PORT=5433
DATABASE_URL=postgres://postgres:@localhost:5433/mokosh

# PMS-285 / PMS-489: split request-serving role. RLS only enforces at runtime
# when the serving connection runs as a NOSUPERUSER NOBYPASSRLS role. The server
# self-provisions two roles at startup (PMS-489) - `mokosh_migrator` (BYPASSRLS,
# used by DATABASE_URL for migrations/bootstrap/workers) and `mokosh_app`
# (NOBYPASSRLS, used by MOKOSH_APP_DATABASE_URL for request serving). On first
# boot, when mokosh_migrator cannot yet connect, the server uses
# MOKOSH_ADMIN_DATABASE_URL (a privileged/superuser connection) to CREATE both
# roles with the passwords below, then closes that pool. Once the roles exist
# the admin URL is unused and may be dropped. Change these passwords for any
# shared environment. Override MOKOSH_APP_DATABASE_URL directly when running the
# server outside compose. If MOKOSH_APP_DATABASE_URL is unset the server falls
# back to DATABASE_URL (single-role, RLS inert) for back-compat.
MOKOSH_MIGRATOR_PASSWORD=
MOKOSH_APP_PASSWORD=
# Privileged connection the server uses once to create the split roles. Point it
# at the postgres superuser. Mirrors DATABASE_URL's host form for host-side runs;
# inside compose it is composed from the MOKOSH_PG_* knobs against `postgres:5432`.
MOKOSH_ADMIN_DATABASE_URL=postgres://postgres:@localhost:5433/mokosh
# Host-side (sqlx-cli etc.) serving-role URL, mirroring DATABASE_URL's host form:
MOKOSH_APP_DATABASE_URL=postgres://mokosh_app:@localhost:5433/mokosh

# Server
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development
BASE_URL=http://localhost:8080

# In-container listen port for the compose `server` service (compose.dev.yml
# maps this to the server's PORT and to the published host port). Required by
# compose interpolation; kept separate from PORT so the host and container
# ports can diverge.
MOKOSH_PORT=8080

# Security. Generated by `ensure-env` on first .env creation (PMS-490):
# JWT_SECRET = 64 hex chars (256-bit); ENCRYPTION_KEY = 64 hex chars (32 bytes,
# per utils::crypto::parse_encryption_key). Outside dev/test (ENVIRONMENT not in
# development|dev|test) the server refuses to boot if JWT_SECRET/ENCRYPTION_KEY
# is unset or equals the built-in dev default (PMS-499), and JWT_SECRET must be
# at least 32 bytes (PMS-497).
JWT_SECRET=
ENCRYPTION_KEY=

# Browser-visible origin of the client that talks to this API. Also the
# default for CORS_ORIGIN and the base for emailed reset/invite links.
# PMS-837: the Google OAuth client id/secret/redirect keys and the
# super-admin email allowlist lived here until the unconsumed Google sign-in
# routes were removed.
CLIENT_ORIGIN=http://localhost:4301

# MAPPS-425: browser origin of the mokosh-apps SPA, used as the base for
# emailed links to pages that exist ONLY there (today: the client request-form
# link, `{SPA_BASE_URL}/request-forms/{token}`). Defaults to CLIENT_ORIGIN,
# which is correct for a single-origin dev stack and left unset here.
#
# It MUST be set on any deployment where the SPA is not the origin that hosts
# login: on staging and production CLIENT_ORIGIN is the apex (bunyip-web owns
# the login UI), while the SPA lives at msp.<apex>. Pointing request links at the apex sends every client to
# bunyip's 404.
#   staging:    SPA_BASE_URL=https://msp.a8n.systems
#   production: SPA_BASE_URL=https://msp.psa.systems
# SPA_BASE_URL=

# PMS-748: address a client can report an unwanted request-form email to. The
# email carries a "report it" link only when this is set, because a link to a
# noreply address, or to the MSP who sent the message, is not an abuse channel.
# Per deployment rather than per tenant for the same reason: it must reach the
# operator of this install, not the sender.
# ABUSE_CONTACT_EMAIL=abuse@example.com

# MAPPS-429: this deployment's own public API base, used to make the tenant logo
# absolute in the request-form email. A mail client cannot resolve a relative
# src, and it is the only caller that needs this; the SPA joins the same path
# with the API base it already resolved. Unset means the email carries no logo,
# which is deliberate: no image beats a broken one.
#
# NOT the same as BASE_URL or SPA_BASE_URL. On staging and production those are
# the apex and the SPA respectively, while the logo is served by the API on a
# third host.
#   staging:    PUBLIC_API_BASE_URL=https://api.msp.a8n.systems
#   production: PUBLIC_API_BASE_URL=https://api.msp.psa.systems
# PUBLIC_API_BASE_URL=

# Upload root for ticket attachments, tenant logos (`tenant-logos/`) and KB
# article images (`kb-articles/`), each in its own subdirectory of it, and the
# per-attachment size cap in bytes. The values shown are the code's own defaults
# (AttachmentConfig::from_env / TenantLogoConfig::from_env). Both are left
# commented on purpose: the dev stack points ATTACHMENT_DIR at
# /data/attachments, a named volume, so an upload survives a container
# rebuild, and setting it here would override that. Any deployed environment
# wants an absolute path on a mounted volume - the code default is relative to
# the server's working directory.
# ATTACHMENT_DIR=./attachments
# ATTACHMENT_MAX_BYTES=26214400

# PMS-923: cap on an image embedded in a KB article, in bytes. Defaults to
# 5 MiB: generous for a screenshot or a diagram, well under the 25 MiB a ticket
# attachment allows, because these are rendered inline in a page rather than
# downloaded on purpose. Stored under ATTACHMENT_DIR in a `kb-articles/`
# subdirectory, so an article image cannot collide with a ticket attachment's
# `{tenant_id}/{attachment_id}` path.
# KB_ATTACHMENT_MAX_BYTES=5242880

# MAPPS-429: cap on an uploaded tenant logo, in bytes. Defaults to 1 MiB, a
# twenty-fifth of the 25 MiB ATTACHMENT_MAX_BYTES default, because this one is
# embedded in every request-form email a client receives. Stored under
# ATTACHMENT_DIR in a `tenant-logos/` subdirectory, so deployments keep one
# mounted volume.
# TENANT_LOGO_MAX_BYTES=1048576

# Trusted reverse-proxy CIDRs (PMS-587). Comma-separated CIDR list. Mokosh runs
# behind Traefik, so the socket peer is the proxy, not the client; the real
# client IP is read from X-Forwarded-For but ONLY when the peer falls inside one
# of these CIDRs, so a direct client cannot spoof the header. Leave unset to use
# the built-in default (loopback + RFC1918/ULA/link-local private ranges), which
# covers a Docker/LAN Traefik. Tighten it to the exact proxy subnet in
# production, e.g. TRUSTED_PROXY_CIDR=10.42.0.0/16.
# TRUSTED_PROXY_CIDR=

# Private outbound targets an operator has declared reachable on purpose
# (PMS-809). Comma-separated list of hostnames, IPs, or CIDRs. Every outbound
# fetch whose URL comes from a request or from tenant-editable configuration
# (the company website probe, the ticket-automation `webhook` action, the RMM
# provider's api_url) resolves the host and refuses any address that is off the
# public internet, so a tenant admin cannot point the server at 127.0.0.1, an
# RFC1918 host, or a cloud metadata endpoint. An entry here exempts a target
# from that screen: a CIDR or IP exempts matching resolved addresses, and a
# hostname exempts that host whatever it resolves to. Leave unset (the default)
# unless a self-hosted integration really does live on a private network, e.g.
# OUTBOUND_PRIVATE_ALLOWLIST=rmm.corp.internal,10.20.0.0/16
# OUTBOUND_PRIVATE_ALLOWLIST=

# First-run admin bootstrap (DEV ONLY).
# When both ADMIN_EMAIL and ADMIN_PASSWORD are set AND no user accounts
# exist yet in the database, the server creates this account on startup
# under the default tenant and assigns the super_admin role. Once any
# user exists these vars are ignored on subsequent startups.
# Do NOT use these credentials outside local development.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database migrations
RUN_MIGRATIONS=true

# Comma-separated list of browser origins allowed by CORS. Unset (the default)
# means "just CLIENT_ORIGIN", which is what a single-origin dev stack wants.
# Every entry must be a valid header value or the server panics at startup.
# CORS_ORIGIN=

# PMS-591: shared secret for the BUNYIP-211 `account_deleted` webhook. Must
# equal bunyip-api's BUNYIP_WEBHOOK_SIGNING_SECRET (BUNYIP-332), which bunyip
# uses service-wide rather than per Application. Same fail-loud posture as
# JWT_SECRET / ENCRYPTION_KEY: development/dev/test fall back to a built-in dev
# value when this is empty, every other environment refuses to boot.
BUNYIP_WEBHOOK_SECRET=

# PMS-657 / BUNYIP-475: optional IP2Location and IP2Proxy binary DB paths,
# inside the server container. IP2LOCATION_DB_PATH turns on country lookup for
# the login-location alert; IP2PROXY_DB_PATH adds ASN / VPN enrichment. Unset
# leaves both enrichments off; the login alert itself still fires.
# IP2LOCATION_DB_PATH=
# IP2PROXY_DB_PATH=

# PMS-658: the suspicious-login notify-and-approve gate. Off by default because
# it can withhold a login: when on, a password login from a new country (needs
# IP2LOCATION_DB_PATH) or a new device is emailed a single-use 6-digit code and
# the client must re-POST /auth/login with `approval_code`. Truthy values are
# 1 / true / yes.
# LOGIN_APPROVAL_ENABLED=false

# PMS-902 / PMS-904: how this instance is deployed. `self-hosted` (the default)
# means mokosh owns platform identities: `users` rows with a password, the local
# /auth/login, and the account email that supports it. `saas` means platform
# identity is federated to Bunyip SSO, so the mokosh-side password is not the
# credential anyone signs in with and the mail that exists only to service it
# (password reset, welcome, new-login-location alert) is suppressed with a log
# line saying why. Business, portal and diagnostic email is unaffected in both
# modes. Unset or unrecognised resolves to `self-hosted`, so a typo cannot
# silently stop a self-hosted deployment's account email.
# MOKOSH_DEPLOYMENT_MODE=self-hosted

# PMS-710: demo-data seeding for a newly provisioned tenant. Production always
# seeds; every other environment seeds only when this is an explicit truthy
# value (1 / true / yes / on). MOKOSH_SEED_TENANT_ID points the copy at a
# template tenant other than the migration-023 seed
# (00000000-0000-0000-0000-000000000001); a value that is not a UUID is a
# startup configuration error.
# MOKOSH_DEMO_SEED=
# MOKOSH_SEED_TENANT_ID=

# Upstream version probe used by the readiness/version endpoint. Unset disables
# the probe entirely; no request leaves the server.
# MOKOSH_UPDATE_CHECK_URL=

# bunyip-as-OP Resource-Server verifier (PMS-295: bunyip is the sole OP).
# OIDC_ISSUER must equal both the token `iss` and bunyip's advertised discovery
# issuer; OIDC_AUDIENCE must equal the `audience` on the mokosh-apps
# oauth_clients row in bunyip-api. The dev stack derives both from ${USER} in
# compose.dev.yml so they always match the Traefik route, which is why they are
# not assigned here. OIDC_DEFAULT_TENANT_ID is the shared landing tenant a
# bunyip user JITs into (PMS-239); unset means the migration-023 seed tenant.
# The two verifier knobs default to a 600s JWKS cache and 30s clock leeway.
# OIDC_DEFAULT_TENANT_ID=
# OIDC_JWKS_CACHE_TTL_SECS=600
# OIDC_LEEWAY_SECONDS=30

# ===========================================================================
# Outbound email.
#
# The host Mailer sends transactional messages (password reset, welcome,
# ticket-note, invites). Two backends, selected by `MailerConfig::from_env`:
#
#   - LogMailer (DEFAULT): writes the would-be message to the tracing
#     log. No bytes leave the server. Selected when SMTP_HOST is unset
#     or empty.
#
#   - SmtpMailer: real SMTP. Selected when SMTP_HOST is set.
#     SMTP_FROM is required and must parse as an RFC 5322 mailbox.
#     SMTP_USERNAME set without SMTP_PASSWORD is a hard error at boot.
#
# Local dev (compose.dev.yml) points SMTP_HOST=mailpit so messages
# land in the mailpit UI at http://localhost:8025. Nothing is delivered
# onward, so no DNS or relay credentials are needed to develop against it.
#
# Production points at a relay (Amazon SES, Postmark, etc). Before the
# first send, publish the relay's SPF and DKIM records for the domain in
# SMTP_FROM: that address's domain has to be one the relay is authorised
# to send for, or receivers reject or spam-folder every message.
#
# PMS-638: these SMTP_* vars are now the FALLBACK. A deployment-wide email
# config set via the admin API (PUT /api/v1/settings/email, admin-only,
# password stored AES-256-GCM-encrypted) overrides them per field and takes
# effect live (no restart). Any field left unset in the DB config falls back
# to the matching SMTP_* var here; with no DB config at all, behaviour is
# exactly as before.
# ===========================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Mokosh <noreply@example.com>
# none | starttls | implicit
SMTP_TLS=starttls

# Stripe (Payment Processing). PMS-836: STRIPE_SECRET_KEY and
# STRIPE_WEBHOOK_SECRET used to be declared here and were read by nothing. A
# tenant's Stripe credentials are per-tenant configuration, stored
# AES-256-GCM-encrypted in the database and decrypted per request
# (modules/billing/provider/stripe.rs), so a deployment-wide key here could
# never have taken effect. STRIPE_API_BASE is the one Stripe variable the code
# does read: it repoints the REST base so a test can drive checkout against a
# stub. Unset means https://api.stripe.com.
# STRIPE_API_BASE=

# PMS-853: the Tactical RMM (TACTICAL_RMM_URL, TACTICAL_RMM_API_KEY), Twilio
# (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER), Slack
# (SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET) and Teams (TEAMS_WEBHOOK_URL) keys
# used to be declared here and were read by nothing. RMM credentials are
# per-tenant rows in `rmm_connections` (modules/rmm/provider.rs), so a
# deployment-wide key could never have taken effect; the SMS, Slack and Teams
# integrations are not wired up at all. Same defect as the PMS-836 Stripe keys
# above: a key that reads as configuration and is inert.

# Infisical Secrets Manager
# Bootstrap by running `just infisical-bootstrap` after `just dev-infisical`
# (Infisical is behind a compose profile and does not start with `just dev`).
# That command will fill in INFISICAL_PROJECT_ID, INFISICAL_CLIENT_ID,
# and INFISICAL_CLIENT_SECRET in your local .env.
# Host-side URL of the dev Infisical instance, read by the bootstrap CLI
# (`src/cli.rs`, `src/bin/mokosh-bootstrap.rs`) as INFISICAL_URL when
# `just infisical-bootstrap` runs it on the host. PMS-853: the key here used to
# carry an older name that nothing has ever read, because PMS-768 moved the code
# to the GOV-50 name and left the template behind.
INFISICAL_URL=http://localhost:28002
INFISICAL_ENVIRONMENT=dev
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# In-network URL handed to the `server` container as INFISICAL_ADDRESS.
# Empty for `just dev` (readiness reports infisical "skipped" instead of
# 503ing against the profile-gated service); `just dev-infisical` sets it
# to http://infisical:8080. Separate name because the value above
# (INFISICAL_URL) is the host-side URL the bootstrap CLI uses (PMS-707).
MOKOSH_SERVER_INFISICAL_ADDRESS=

# Infisical self-hosted dev instance (compose `infisical` profile). These feed
# the bundled Infisical + its Postgres/Valkey sidecars in compose.dev.yml and
# are required by compose interpolation (${VAR:?...}) even when the infisical
# profile is not started (compose interpolates the whole file at parse time).
# Dev-only values; rotate every secret before any shared or production use.
INFISICAL_PG_DB=infisical
INFISICAL_PG_USER=infisical
INFISICAL_PG_PASSWORD=
INFISICAL_DB_CONNECTION_URI=postgres://infisical:@infisical-postgres:5432/infisical
INFISICAL_REDIS_URL=redis://valkey:6379
INFISICAL_SITE_URL=http://localhost:28002
INFISICAL_TELEMETRY_ENABLED=false
# Infisical requires a 32-hex-char (16-byte) ENCRYPTION_KEY and a random
# AUTH_SECRET. Both are generated by `ensure-env` on first .env creation
# (openssl rand -hex 16 / openssl rand -base64 32), so they are left empty here.
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=

# Logging
RUST_LOG=info,mokosh_server=debug
