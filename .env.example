# Mokosh Server Environment Configuration
# Copy this file to .env and update the values

# Application database. Runs as the `postgres` service inside the dev
# compose stack; the host-published port (default 5433) is what sqlx-cli
# and other host-side tools connect to. Container-side connection is
# composed inline in compose.dev.yml from the MOKOSH_PG_* knobs below.
MOKOSH_PG_DB=mokosh
MOKOSH_PG_USER=postgres
MOKOSH_PG_PASSWORD=postgres
MOKOSH_PG_HOST_PORT=5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/mokosh

# Server
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development
BASE_URL=http://localhost:8080

# Security
JWT_SECRET=change-this-to-a-secure-random-string-in-production
ENCRYPTION_KEY=32-byte-key-for-dev-only-change!

# Google OAuth login.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application"). The redirect URI must
# match an "Authorized redirect URI" exactly. CLIENT_ORIGIN must match
# an "Authorized JavaScript origin" exactly and is the only origin the
# callback HTML will postMessage tokens to.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4301/api/v1/auth/google/callback
CLIENT_ORIGIN=http://localhost:4301

# Comma-separated, lowercased email-domain allowlist. First-time Google
# sign-ins from these domains are auto-promoted to role 'super_admin'.
# Existing users are never re-roled.
OAUTH_SUPER_ADMIN_DOMAINS=niceguyit.biz

# First-run admin bootstrap (DEV ONLY).
# When both ADMIN_EMAIL and ADMIN_PASSWORD are set AND no user accounts
# exist yet in the database, the server creates this account on startup
# under the default tenant and assigns the super_admin role. Once any
# user exists these vars are ignored on subsequent startups.
# Do NOT use these credentials outside local development.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database migrations
RUN_MIGRATIONS=true

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Mokosh Server <noreply@example.com>

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Tactical RMM Integration
TACTICAL_RMM_URL=https://your-tactical-rmm.example.com
TACTICAL_RMM_API_KEY=your-api-key

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Slack Integration
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Microsoft Teams Integration
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# Infisical Secrets Manager
# Bootstrap by running `just infisical-bootstrap` after `just dev`.
# That command will fill in INFISICAL_PROJECT_ID, INFISICAL_CLIENT_ID,
# and INFISICAL_CLIENT_SECRET in your local .env.
INFISICAL_BASE_URL=http://localhost:28002
INFISICAL_ENVIRONMENT=dev
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Logging
RUST_LOG=info,mokosh_server=debug
