# Mokosh Server Environment Configuration
#
# Do NOT copy this file to .env by hand. Run `just dev` (or any recipe that
# depends on `ensure-env`); on first .env creation that recipe generates a
# strong random value for every self-owned secret (DB passwords, JWT_SECRET,
# ENCRYPTION_KEY, the Infisical encryption/auth secrets) so no generic password
# ever lands in .env (PMS-490). The self-owned secret values below are therefore
# left empty on purpose - they are placeholders the generator fills in.
# Third-party credentials (Google, Stripe, Twilio, Slack, Infisical client) are
# the only values you fill in manually.

# Application database. Runs as the `postgres` service inside the dev
# compose stack; the host-published port (default 5433) is what sqlx-cli
# and other host-side tools connect to. Container-side connection is
# composed inline in compose.dev.yml from the MOKOSH_PG_* knobs below.
MOKOSH_PG_DB=mokosh
MOKOSH_PG_USER=postgres
MOKOSH_PG_PASSWORD=
MOKOSH_PG_HOST_PORT=5433
DATABASE_URL=postgres://postgres:@localhost:5433/mokosh

# PMS-285 / PMS-489: split request-serving role. RLS only enforces at runtime
# when the serving connection runs as a NOSUPERUSER NOBYPASSRLS role. The server
# self-provisions two roles at startup (PMS-489) - `mokosh_migrator` (BYPASSRLS,
# used by DATABASE_URL for migrations/bootstrap/workers) and `mokosh_app`
# (NOBYPASSRLS, used by MOKOSH_APP_DATABASE_URL for request serving). On first
# boot, when mokosh_migrator cannot yet connect, the server uses
# MOKOSH_ADMIN_DATABASE_URL (a privileged/superuser connection) to CREATE both
# roles with the passwords below, then closes that pool. Once the roles exist
# the admin URL is unused and may be dropped. Change these passwords for any
# shared environment. Override MOKOSH_APP_DATABASE_URL directly when running the
# server outside compose. If MOKOSH_APP_DATABASE_URL is unset the server falls
# back to DATABASE_URL (single-role, RLS inert) for back-compat.
MOKOSH_MIGRATOR_PASSWORD=
MOKOSH_APP_PASSWORD=
# Privileged connection the server uses once to create the split roles. Point it
# at the postgres superuser. Mirrors DATABASE_URL's host form for host-side runs;
# inside compose it is composed from the MOKOSH_PG_* knobs against `postgres:5432`.
MOKOSH_ADMIN_DATABASE_URL=postgres://postgres:@localhost:5433/mokosh
# Host-side (sqlx-cli etc.) serving-role URL, mirroring DATABASE_URL's host form:
MOKOSH_APP_DATABASE_URL=postgres://mokosh_app:@localhost:5433/mokosh

# Server
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development
BASE_URL=http://localhost:8080

# In-container listen port for the compose `server` service (compose.dev.yml
# maps this to the server's PORT and to the published host port). Required by
# compose interpolation; kept separate from PORT so the host and container
# ports can diverge.
MOKOSH_PORT=8080

# Security. Generated by `ensure-env` on first .env creation (PMS-490):
# JWT_SECRET = 64 hex chars (256-bit); ENCRYPTION_KEY = 64 hex chars (32 bytes,
# per utils::crypto::parse_encryption_key). Outside dev/test (ENVIRONMENT not in
# development|dev|test) the server refuses to boot if JWT_SECRET/ENCRYPTION_KEY
# is unset or equals the built-in dev default (PMS-499), and JWT_SECRET must be
# at least 32 bytes (PMS-497).
JWT_SECRET=
ENCRYPTION_KEY=

# Google OAuth login.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application"). The redirect URI must
# match an "Authorized redirect URI" exactly. CLIENT_ORIGIN must match
# an "Authorized JavaScript origin" exactly and is the only origin the
# callback HTML will postMessage tokens to.
# These are non-empty placeholders so compose interpolation (${VAR:?...})
# succeeds on a clean clone; replace with real dev credentials to exercise
# the Google sign-in flow.
GOOGLE_OAUTH_CLIENT_ID=dev-placeholder.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=dev-placeholder-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4301/api/v1/auth/google/callback
CLIENT_ORIGIN=http://localhost:4301

# Comma-separated, lowercased email-domain allowlist. First-time Google
# sign-ins from these domains are auto-promoted to role 'super_admin'.
# Existing users are never re-roled.
OAUTH_SUPER_ADMIN_DOMAINS=niceguyit.biz

# First-run admin bootstrap (DEV ONLY).
# When both ADMIN_EMAIL and ADMIN_PASSWORD are set AND no user accounts
# exist yet in the database, the server creates this account on startup
# under the default tenant and assigns the super_admin role. Once any
# user exists these vars are ignored on subsequent startups.
# Do NOT use these credentials outside local development.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database migrations
RUN_MIGRATIONS=true

# ===========================================================================
# Outbound email.
#
# The host Mailer sends transactional messages (password reset, welcome,
# ticket-note, invites). Two backends, selected by `MailerConfig::from_env`:
#
#   - LogMailer (DEFAULT): writes the would-be message to the tracing
#     log. No bytes leave the server. Selected when SMTP_HOST is unset
#     or empty.
#
#   - SmtpMailer: real SMTP. Selected when SMTP_HOST is set.
#     SMTP_FROM is required and must parse as an RFC 5322 mailbox.
#     SMTP_USERNAME set without SMTP_PASSWORD is a hard error at boot.
#
# Local dev (compose.dev.yml) points SMTP_HOST=mailpit so messages
# land in the mailpit UI at http://localhost:8025. See
# docs/mokosh-smtp/01-dev-mailcatcher.md.
#
# Production points at a relay (Amazon SES, Postmark, etc). See
# docs/mokosh-smtp/06-rollout.md for the full prod checklist including
# DKIM/SPF DNS records.
# ===========================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Mokosh <noreply@example.com>
# none | starttls | implicit
SMTP_TLS=starttls

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Tactical RMM Integration
TACTICAL_RMM_URL=https://your-tactical-rmm.example.com
TACTICAL_RMM_API_KEY=your-api-key

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Slack Integration
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Microsoft Teams Integration
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# Infisical Secrets Manager
# Bootstrap by running `just infisical-bootstrap` after `just dev`.
# That command will fill in INFISICAL_PROJECT_ID, INFISICAL_CLIENT_ID,
# and INFISICAL_CLIENT_SECRET in your local .env.
INFISICAL_BASE_URL=http://localhost:28002
INFISICAL_ENVIRONMENT=dev
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Infisical self-hosted dev instance (compose `infisical` profile). These feed
# the bundled Infisical + its Postgres/Valkey sidecars in compose.dev.yml and
# are required by compose interpolation (${VAR:?...}) even when the infisical
# profile is not started (compose interpolates the whole file at parse time).
# Dev-only values; rotate every secret before any shared or production use.
INFISICAL_PG_DB=infisical
INFISICAL_PG_USER=infisical
INFISICAL_PG_PASSWORD=
INFISICAL_DB_CONNECTION_URI=postgres://infisical:@infisical-postgres:5432/infisical
INFISICAL_REDIS_URL=redis://valkey:6379
INFISICAL_SITE_URL=http://localhost:28002
INFISICAL_TELEMETRY_ENABLED=false
# Infisical requires a 32-hex-char (16-byte) ENCRYPTION_KEY and a random
# AUTH_SECRET. Both are generated by `ensure-env` on first .env creation
# (openssl rand -hex 16 / openssl rand -base64 32), so they are left empty here.
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=

# Logging
RUST_LOG=info,mokosh_server=debug
