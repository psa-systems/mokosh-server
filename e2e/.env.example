# Copy to `e2e/.env` for local runs. Local `.env` always uses these plain
# unprefixed E2E_* names for whichever single environment you are testing.
#
# In CI the values come from Forgejo Actions secrets that hold both staging and
# production at once. Their names match the deployment's own variables where one
# exists (MOKOSH_OIDC_CLIENT_ID, MOKOSH_APPS_REDIRECT_URIS_*, OIDC_ISSUER_*) and
# use E2E_STAGING_* / E2E_PRODUCTION_* for the test-only vars; the workflow
# selects per run and exposes the result on these plain names, so the suite
# itself never sees the prefix (see .forgejo/workflows/e2e.yml and e2e/README.md,
# PMS-271). Production runs are manual-dispatch only.
#
# Never commit a filled-in .env.

# REQUIRED: SPA host the human-facing app is served on. The browser projects
# (`setup`, `chromium`, `firefox`, `webkit`) navigate here. No default; set the
# per-environment host explicitly
# (staging `https://msp.a8n.systems`, prod `https://msp.psa.systems`).
E2E_BASE_URL=https://msp.a8n.systems

# OPTIONAL: API host. The api project and teardown hit this host for
# `/api/v1/*`. When unset it is derived from E2E_BASE_URL by prepending
# `api.`, so `msp.a8n.systems` -> `api.msp.a8n.systems`. Set explicitly
# when the deployment uses a different naming scheme.
E2E_API_BASE_URL=

# RECOMMENDED: OIDC OP host. The oidc.spec test hits `/oauth2/*` and
# `/.well-known/openid-configuration` here. bunyip is the only OP; mokosh
# hosts no `/oauth2/*` endpoints at all (PMS-295), and the OP runs on the
# apex `api.<tld>`, NOT the mokosh API host `api.msp.<tld>`. Set it
# explicitly: when unset it falls back to E2E_API_BASE_URL, which points at
# mokosh and 404s on discovery.
E2E_OP_BASE_URL=

# Pre-provisioned, dedicated E2E account on the deployment (see README.md).
E2E_EMAIL=e2e@example.test
E2E_PASSWORD=change-me

# UUID of the dedicated E2E tenant the account belongs to. Used to label and
# scope all test-created records.
E2E_TENANT_ID=00000000-0000-0000-0000-000000000000

# Public OIDC client id used for the token-flow test, registered with bunyip.
# Reuse the staging SPA public client, or a dedicated E2E client.
E2E_OIDC_CLIENT_ID=mokosh-clients

# REQUIRED: redirect URI registered for E2E_OIDC_CLIENT_ID. The token-flow
# test only captures the `code` from the 302 Location; it never loads this
# URL. It MUST exactly match a registered redirect_uri for the client, or the
# OP returns invalid_redirect_uri at /oauth2/authorize or /oauth2/token. For
# the mokosh-apps public client this is `/auth/callback` (the value bunyip-api
# registers as MOKOSH_APPS_REDIRECT_URIS), not `/oauth2/callback`.
E2E_OIDC_REDIRECT_URI=https://msp.a8n.systems/auth/callback

# REQUIRED: base32 TOTP secret for E2E_EMAIL's authenticator. Setup uses it
# to compute the second-factor code at runtime (same string you originally
# pasted into your authenticator app when enrolling 2FA on the account).
# Treat as sensitive; never commit a filled value.
E2E_TOTP_SECRET=

# OPTIONAL, and genuinely optional: id of a company that lives in a DIFFERENT
# tenant than E2E_TENANT_ID. The cross-tenant leak canary in
# tests/contacts.spec.ts ALWAYS runs; leaving this unset never skips it.
# What it costs is assertion strength: `global.setup.ts` then substitutes a
# random, well-formed UUID, so the canary only proves the E2E account cannot
# read a company that does not exist. Set it and the canary proves the account
# cannot read a real company another tenant owns, which is the leak that
# matters.
E2E_FOREIGN_COMPANY_ID=

# OPTIONAL: target environment name, `staging` or `production` (PMS-608). CI
# sets it from the dispatch input; the external-service guard
# (tests/external-guard.spec.ts) reads it to assert `@external`-tagged tests
# never run against production. Leave unset locally (treated as non-production).
E2E_ENVIRONMENT=staging
