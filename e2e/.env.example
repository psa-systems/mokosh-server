# Copy to `e2e/.env` for local runs. In CI these come from Forgejo Actions
# secrets (see .forgejo/workflows/e2e.yml). Never commit a filled-in .env.

# SPA host the human-facing app is served on. The auth-ui project navigates
# here. Defaults to staging when unset.
E2E_BASE_URL=https://msp.a8n.systems

# OPTIONAL: API host. The api project, teardown, and the deploy-sync gate
# all hit this host (`/api/v1/*`, `/oauth2/*`, `/.well-known/*`). When unset
# it is derived from E2E_BASE_URL by prepending `api.`, so
# `msp.a8n.systems` -> `api.msp.a8n.systems`. Set explicitly when the
# deployment uses a different naming scheme.
E2E_API_BASE_URL=

# Pre-provisioned, dedicated E2E account on the deployment (see README.md).
E2E_EMAIL=e2e@example.test
E2E_PASSWORD=change-me

# UUID of the dedicated E2E tenant the account belongs to. Used to label and
# scope all test-created records.
E2E_TENANT_ID=00000000-0000-0000-0000-000000000000

# Public OIDC client id used for the token-flow test. Reuse the staging SPA
# public client, or a dedicated E2E client.
E2E_OIDC_CLIENT_ID=mokosh-clients

# REQUIRED: redirect URI registered for E2E_OIDC_CLIENT_ID. The token-flow
# test only captures the `code` from the 302 Location; it never loads this
# URL. It MUST exactly match a registered redirect_uri for the client, or the
# OP returns invalid_redirect_uri at /oauth2/authorize or /oauth2/token.
E2E_OIDC_REDIRECT_URI=https://msp.a8n.systems/oauth2/callback

# REQUIRED: base32 TOTP secret for E2E_EMAIL's authenticator. Setup uses it
# to compute the second-factor code at runtime (same string you originally
# pasted into your authenticator app when enrolling 2FA on the account).
# Treat as sensitive; never commit a filled value.
E2E_TOTP_SECRET=

# OPTIONAL: id of a company that lives in a DIFFERENT tenant than E2E_TENANT_ID.
# Enables the cross-tenant leak canary (the E2E account must NOT be able to read
# it). When unset, that test is skipped with a reason.
E2E_FOREIGN_COMPANY_ID=
